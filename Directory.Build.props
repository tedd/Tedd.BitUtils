<Project>
  <!--
    Repository root build defaults. Having this file here also stops MSBuild from walking further up the directory
    tree for a Directory.Build.props on a developer machine (e.g. a shared props file for sibling repos), so local
    builds behave the same as a clean CI checkout.

    Deliberately minimal: LangVersion/Nullable/etc. are left to each project (already set on Tedd.BitUtils itself)
    rather than forced here, since a repo-wide override changes how every project compiles, including ones that
    don't need it.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
