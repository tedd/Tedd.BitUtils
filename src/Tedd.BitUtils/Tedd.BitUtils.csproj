<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net6.0  : floor. Oldest .NET this package supports (System.Numerics.BitOperations + hardware intrinsics with
                automatic runtime fallback on unsupported CPUs). .NET Framework / .NET Standard are no longer targeted.
      net8.0  : current LTS.
      net10.0 : latest LTS. net7.0/net9.0 (STS, both EOL) consumers resolve to the net6.0 or net8.0 asset.
    -->
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Tedd</RootNamespace>
    <AssemblyName>Tedd.BitUtils</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>tedd</Authors>
    <Company>Tedd Hansen</Company>
    <Copyright>Tedd Hansen</Copyright>
    <Description>Fast bit manipulation extension methods for SByte, Byte, Int16, UInt16, Int32, UInt32, Int64 and UInt64: SetBit, SetBit0, SetBit1, ToggleBit, IsBitSet, Rol, Ror, ReverseBits, ReverseEndianness, PopCount, Parity, LeadingZeroCount, TrailingZeroCount, Log2, BitLength, IsPowerOfTwo, RoundUpToPowerOf2, ExtractLowestSetBit, ResetLowestSetBit, GetMaskUpToLowestSetBit, ExtractHighestSetBit, ZeroHighBits, ZeroLowBits, ParallelBitExtract (PEXT), ParallelBitDeposit (PDEP), Pack, Unpack, ToBitString. Backed by System.Numerics.BitOperations and hardware intrinsics (POPCNT, LZCNT, TZCNT, BMI1, BMI2, BSWAP, ARM RBIT) with automatic runtime fallback.</Description>
    <PackageTags>bit;bits;bitwise;setbit;getbit;isbitset;togglebit;pack;unpack;ror;rol;rotate;reverse;reversebits;popcount;popcnt;parity;leadingzerocount;lzcnt;trailingzerocount;tzcnt;log2;bitlength;ispow2;poweroftwo;bmi1;bmi2;pext;pdep;bzhi;blsi;blsr;tobitstring;reverseendianness;endian;bswap;intrinsics</PackageTags>
    <PackageProjectUrl>https://github.com/tedd/Tedd.BitUtils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tedd/Tedd.BitUtils.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0: BREAKING - now targets net6.0, net8.0 and net10.0 only; .NET Framework and .NET Standard consumers must stay on 1.x. Every operation is now backed directly by System.Numerics.BitOperations and hardware intrinsics (POPCNT, LZCNT, TZCNT, BMI1, BMI2, BSWAP, ARM64 RBIT). New: ToggleBit, Parity, TrailingZeroCount, Log2, BitLength, IsPowerOfTwo, RoundUpToPowerOf2, ExtractLowestSetBit, ResetLowestSetBit, GetMaskUpToLowestSetBit, ExtractHighestSetBit, ZeroHighBits, ZeroLowBits, ParallelBitExtract, ParallelBitDeposit, Rol/Ror for SByte/Byte/Int16/UInt16, plus SByte overloads throughout. Fixed: ReverseEndianness previously never took the intrinsic path due to an always-false compile constant and always ran the naive software fallback; it now always calls BinaryPrimitives.ReverseEndianness. Faster ReverseBits on x86/x64 (branch-free SWAR instead of table lookups).</PackageReleaseNotes>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tedd.BitUtils.Tests" />
    <InternalsVisibleTo Include="Tedd.BitUtils.Benchmarks" />
  </ItemGroup>

</Project>
